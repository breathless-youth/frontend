+#import <React/RCTConversions.h>
 
 using namespace facebook::react;
 
@@ -494,6 +495,14 @@ - (void)updateProps:(Props::Shared const &)props oldProps:(Props::Shared const &
     }
     [_view setSource:source];
 
+    // Fabric의 RCTViewComponentView는 배경색을 이 래퍼 뷰에만 칠하고 안쪽 RNCWebViewImpl에는
+    // 알리지 않는다. 그러면 WKWebView는 기본 흰 바탕으로 만들어져, 문서가 채우지 못한 여백이
+    // 흰색으로 드러난다. 소수점 프레임 높이의 마지막 픽셀 줄, 오버스크롤 구간, 재부착 직후
