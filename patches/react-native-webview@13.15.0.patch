+    if (oldViewProps.backgroundColor != newViewProps.backgroundColor) {
+        [_view setBackgroundColor:RCTUIColorFromSharedColor(newViewProps.backgroundColor)];
+    }
+
     [super updateProps:props oldProps:oldProps];
