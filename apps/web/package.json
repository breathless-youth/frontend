    "perf:build:before": "node scripts/copyMediapipeWasm.js && VITE_VISION_PREFETCH=off VITE_PERF_PANEL=1 VITE_SENTRY_DSN= VITE_AMPLITUDE_API_KEY= VITE_GA4_MEASUREMENT_ID= VITE_API_BASE_URL= VITE_DEPLOY_ENV= SENTRY_AUTH_TOKEN= vite build --outDir .perf/dist-before",
    "perf:build:after": "node scripts/copyMediapipeWasm.js && VITE_PERF_PANEL=1 VITE_SENTRY_DSN= VITE_AMPLITUDE_API_KEY= VITE_GA4_MEASUREMENT_ID= VITE_API_BASE_URL= VITE_DEPLOY_ENV= SENTRY_AUTH_TOKEN= vite build --outDir .perf/dist-after",
    "perf:serve": "node scripts/perf/serve.mjs",
    "perf:measure": "node scripts/perf/measure-prefetch.mjs",
    "perf:build:worker-off": "node scripts/copyMediapipeWasm.js && VITE_VISION_WORKER=off VITE_PERF_PANEL=1 VITE_SENTRY_DSN= VITE_AMPLITUDE_API_KEY= VITE_GA4_MEASUREMENT_ID= VITE_API_BASE_URL= VITE_DEPLOY_ENV= SENTRY_AUTH_TOKEN= vite build --outDir .perf/dist-worker-off",
    "perf:build:worker-on": "node scripts/copyMediapipeWasm.js && VITE_PERF_PANEL=1 VITE_SENTRY_DSN= VITE_AMPLITUDE_API_KEY= VITE_GA4_MEASUREMENT_ID= VITE_API_BASE_URL= VITE_DEPLOY_ENV= SENTRY_AUTH_TOKEN= vite build --outDir .perf/dist-worker-on",
