# 이 파일을 복사해 같은 위치에 `.env.local`로 저장하고 값을 채우세요.
#
#   cp .env.local.example .env.local
#
# 개발 백엔드 API 주소 (운영 주소를 넣으면 app.config.ts의 가드가 기동을 막습니다)
API_BASE_URL=
# 세션 화면을 띄울 웹 주소 (로컬 Vite dev 서버 또는 터널 주소)
WEB_BASE_URL=
# Firebase 설정 파일 경로 (dev 프로젝트, apps/mobile 기준 상대 경로 — BY-585).
# prebuild·EAS 빌드에만 필요하고 Metro만 띄울 때는 비워도 됩니다. 파일은 apps/mobile/firebase/ 아래(gitignore)에 둡니다.
GOOGLE_SERVICES_JSON=./firebase/dev/google-services.json
GOOGLE_SERVICES_PLIST=./firebase/dev/GoogleService-Info.plist
