{
  "expo": {
    "name": "FocusMakers",
    "slug": "mobile",
    "version": "26.40.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "experiments": {
      "reactCompiler": true
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "집중 측정에 사용해요. 영상은 기기 안에서만 처리되고 저장되지 않아요.",
        "NSMotionUsageDescription": "기기를 만지는 순간을 감지해요. 센서 값은 기기 안에서만 쓰이고 저장되지 않아요.",
        "NSUserTrackingUsageDescription": "설치 경로와 광고 효과를 확인하는 데 사용해요. 카메라 영상과 얼굴 데이터는 광고에 쓰이지 않아요.",
        "NSPhotoLibraryAddUsageDescription": "타임랩스 영상을 사진 앱에 저장하려면 사진 추가 권한이 필요해요",
        "NSPhotoLibraryUsageDescription": "타임랩스 영상을 사진 앱에 저장할 때 사용해요",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "ko",
        "CFBundleLocalizations": ["ko"],
        "CFBundleAllowMixedLocalizations": true
      },
      "bundleIdentifier": "com.breathlessyouth.mobile",
      "entitlements": {
        "aps-environment": "development"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#fdd9bb",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["CAMERA", "HIGH_SAMPLING_RATE_SENSORS"],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ],
      "package": "com.breathlessyouth.mobile"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#f8fafd",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#0d1118"
          }
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "breathless-youth",
          "project": "focusmakers-app",
          "experimental_android": {
            "enableAndroidGradlePlugin": true,
            "uploadNativeSymbols": false,
            "includeNativeSources": false
          }
        }
      ],
      "./plugins/withAppDisplayName",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          },
          "ios": {
            "useFrameworks": "dynamic",
            "forceStaticLinking": ["react-native-fbsdk-next"]
          }
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      [
        "expo-media-library",
        {
          "photosPermission": "타임랩스 영상을 사진 앱에 저장할 때 사용해요",
          "savePhotosPermission": "타임랩스 영상을 사진 앱에 저장하려면 사진 추가 권한이 필요해요",
          "granularPermissions": []
        }
      ],
      ["react-native-share", {}]
    ],
    "extra": {
      "appDisplayName": "포커스 메이커스",
      "apiBaseUrl": "",
      "webBaseUrl": "",
      "sentryDsn": "https://bd5fbe3fcc00fd2ca2b605d6095617ea@o4511838823448576.ingest.us.sentry.io/4511861049589760",
      "eas": {
        "projectId": "3fa9e1f9-3eac-440a-b0ad-b61cf8f527d3"
      }
    },
    "owner": "breathless-youth"
  }
}
