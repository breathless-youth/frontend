{
  "expo": {
    "name": "FocusMakers",
    "slug": "mobile",
    "scheme": "focuson",
    "version": "1.0.1",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "집중 측정에 사용해요. 영상은 기기 안에서만 처리되고 저장되지 않아요.",
        "NSMotionUsageDescription": "기기를 만지는 순간을 감지해요. 센서 값은 기기 안에서만 쓰이고 저장되지 않아요.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "1",
      "bundleIdentifier": "com.breathlessyouth.mobile"
    },
    "android": {
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#fdd9bb",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["CAMERA", "HIGH_SAMPLING_RATE_SENSORS"],
      "package": "com.breathlessyouth.mobile"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#101419"
          }
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "breathless-youth",
          "project": "focusmakers-app"
        }
      ],
      "./plugins/withAppDisplayName"
    ],
    "extra": {
      "appDisplayName": "포커스 메이커스",
      "apiBaseUrl": "https://api.sunqstudio.kr",
      "webBaseUrl": "https://web.sunqstudio.kr",
      "sentryDsn": "https://bd5fbe3fcc00fd2ca2b605d6095617ea@o4511838823448576.ingest.us.sentry.io/4511861049589760",
      "eas": {
        "projectId": "3fa9e1f9-3eac-440a-b0ad-b61cf8f527d3"
      }
    },
    "owner": "breathless-youth"
  }
}
