{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "development-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "production"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "production"
      }
    },
    "qa": {
      "distribution": "internal",
      "env": {
        "API_BASE_URL": "https://api-dev.focusmakers.app",
        "WEB_BASE_URL": "https://web-dev.focusmakers.app"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
